# Everything provision.sh installs outside mise (sourced by bash). Each
# download is checked before use: *_SHA256 for fixed release files, or the
# code signature (*_SIGNER, checked with codesign) where only a signed
# download is published. The dockurr macOS guest is Intel (x86_64).

MISE_VERSION=2026.9.18
MISE_URL=https://github.com/jdx/mise/releases/download/v2026.9.18/mise-v2026.9.18-macos-x64.tar.gz
MISE_SHA256=e1fd0d0a7c93428cc4eaf61a0bdb26f0a50d4401283458c1182d3dcc6fb9b234

RUSTUP_VERSION=1.29.0
RUSTUP_URL=https://static.rust-lang.org/rustup/archive/1.29.0/x86_64-apple-darwin/rustup-init
RUSTUP_SHA256=33cf85df9142bc6d29cbc62fa5ca1d4c29622cddb55213a4c1a43c457fb9b2d7

RUNNER_VERSION=2.337.0
RUNNER_URL=https://github.com/actions/runner/releases/download/v2.337.0/actions-runner-osx-x64-2.337.0.tar.gz
RUNNER_SHA256=d383f505d7ed041b1873ab68c35dd766fc093f2252330f95bb427be8f2c6dcfc

VULKAN_SDK_VERSION=1.4.357.0
VULKAN_SDK_URL=https://sdk.lunarg.com/sdk/download/1.4.357.0/mac/vulkansdk-macos-1.4.357.0.zip
VULKAN_SDK_SIGNER="LunarG"
