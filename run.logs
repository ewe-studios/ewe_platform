          "type": "string"
        },
        "id": {
          "description": "[Output Only] Unique identifier for the resource; defined by the server.",
          "type": "string"
        },
        "items": {
          "description": "A list of FirewallPolicy resources.",
          "type": "array",
          "items": {
            "$ref": "FirewallPolicy"
