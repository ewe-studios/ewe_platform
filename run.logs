            "Trigger maintenance only on the hosts belonging to this reservation which\ndo not have any VMs running on them. This is not allowed for Standard ExR"
          ],
          "enum": [
            "ALL",
            "MAINTENANCE_SCOPE_UNSPECIFIED",
            "RUNNING_VMS",
            "UNUSED_CAPACITY"
          ]
        }
      }
