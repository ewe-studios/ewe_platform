            "",
            ""
          ],
          "enum": [
            "HEALTHY",
            "UNHEALTHY",
            "UNKNOWN"
          ]
        },
        "healthSources": {
          "description": "Health sources and their corresponding health states.",
          "type": "array",
          "items": {
            "$ref": "CompositeHealthChecksGetHealthResponseHealthSourceHealth"
          }
        }
