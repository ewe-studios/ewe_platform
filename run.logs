          "readOnly": true,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "zones": {
          "description": "Output only. [Output Only] Zones used to explain this blocker in more detail.\nFormat is \"zone1\" and/or \"zone2\". This will be set for some blockers\n(like  MISSING_ZONE) but does not apply to others.",
