            false,
            false,
            true,
            false,
            true,
            false,
            false
          ],
          "enum": [
            "ACCEPTED",
            "CANCELLED",
            "CREATING",
            "DELETING",
            "FAILED",
            "PROVISIONING",
            "STATE_UNSPECIFIED",
            "SUCCEEDED"
          ]
        },
        "status": {
          "description": "Output only. [Output only] Status of the request.",
          "readOnly": true,
          "$ref": "InstanceGroupManagerResizeRequestStatus"
