    "ZoneSetLabelsRequest": {
      "id": "ZoneSetLabelsRequest",
      "type": "object",
      "properties": {
        "labels": {
          "description": "The labels to set for this resource.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "labelFingerprint": {
