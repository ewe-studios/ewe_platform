    "QueuedResource": {
      "id": "QueuedResource",
      "description": "QueuedResource represents a request for future capacity. The capacity is\ndelivered in the form of other GCE resources, either Instances or\nReservations.",
      "type": "object",
      "properties": {
        "bulkInsertInstanceResource": {
          "description": "Specification of VM instances to create.",
          "$ref": "BulkInsertInstanceResource"
        },
        "kind": {
          "description": "Output only. [Output Only] Type of the resource. Alwayscompute#queuedResource for QueuedResources.",
          "default": "compute#queuedResource",
          "readOnly": true,
          "type": "string"
        },
        "id": {
          "description": "Output only. [Output Only] The unique identifier for the resource. This identifier is\ndefined by the server.",
          "readOnly": true,
          "type": "string",
          "format": "uint64"
        },
        "creationTimestamp": {
          "description": "Output only. [Output Only] Creation timestamp in RFC3339\ntext format.",
          "readOnly": true,
          "type": "string"
        },
        "name": {
          "description": "Name of the resource. Provided by the client when the resource is created.\nThe name must be 1-63 characters long, and comply withRFC1035.\nSpecifically, the name must be 1-63 characters long and match the regular\nexpression `[a-z]([-a-z0-9]*[a-z0-9])?` which means the first character\nmust be a lowercase letter, and all following characters must be a dash,\nlowercase letter, or digit, except the last character, which cannot be a\ndash.",
          "pattern": "[a-z](?:[-a-z0-9]{0,61}[a-z0-9])?",
          "type": "string"
        },
        "description": {
          "description": "An optional description of this resource. Provide this property when you\ncreate the resource.",
          "type": "string"
        },
        "selfLink": {
          "description": "Output only. [Output only] Server-defined URL for the resource.",
          "readOnly": true,
          "type": "string"
        },
        "selfLinkWithId": {
          "description": "Output only. [Output Only] Server-defined URL for this resource with the resource id.",
          "readOnly": true,
          "type": "string"
        },
        "zone": {
          "description": "Output only. [Output Only] URL of the zone where the resource resides. Only applicable\nfor zonal resources. You must specify this field as part of the HTTP\nrequest URL. It is not settable as a field in the request body.",
          "readOnly": true,
          "type": "string"
        },
        "queuingPolicy": {
          "description": "Queuing parameters for the requested capacity.",
          "$ref": "QueuingPolicy"
        },
        "state": {
          "description": "Output only. [Output only] High-level status of the request.",
          "readOnly": true,
          "type": "string",
          "enumDescriptions": [
            "The request was created successfully and was accepted for provisioning\nwhen the capacity becomes available.",
            "The request was canceled by the user.",
            "QueuedResource is being created and may still fail creation.",
            "The request is being deleted.",
            "The request failed before or during provisioning.",
            "The target resource(s) are being provisioned.",
            "",
            "The request succeeded."
          ],
          "enum": [
            "ACCEPTED",
            "CANCELLED",
            "CREATING",
            "DELETING",
            "FAILED",
            "PROVISIONING",
            "STATE_UNSPECIFIED",
            "SUCCEEDED"
          ]
        },
        "status": {
          "description": "Output only. [Output only] Result of queuing and provisioning based on deferred\ncapacity.",
          "readOnly": true,
          "$ref": "QueuedResourceStatus"
        }
      }
    },
    "QueuingPolicy": {
      "id": "QueuingPolicy",
      "description": "Queuing parameters for the requested deferred capacity.",
      "type": "object",
      "properties": {
        "validUntilTime": {
          "description": "Absolute deadline for waiting for capacity inRFC3339\ntext format.",
          "type": "string"
        },
        "validUntilDuration": {
          "description": "Relative deadline for waiting for capacity.",
          "$ref": "Duration"
        }
      }
    },
    "QueuedResourceStatus": {
      "id": "QueuedResourceStatus",
      "description": "[Output only] Result of queuing and provisioning based on deferred\ncapacity.",
      "type": "object",
      "properties": {
        "failedData": {
          "description": "Output only. Additional status detail for the FAILED state.",
          "readOnly": true,
          "$ref": "QueuedResourceStatusFailedData"
        },
        "queuingPolicy": {
          "description": "Output only. Constraints for the time when the resource(s) start provisioning. Always\nexposed as absolute times.",
          "readOnly": true,
          "$ref": "QueuingPolicy"
        },
        "provisioningOperations": {
          "description": "Output only. [Output only] Fully qualified URL of the provisioning GCE operation to\ntrack the provisioning along with provisioning errors. The referenced\noperation may not exist after having been deleted or expired.",
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "QueuedResourceStatusFailedData": {
      "id": "QueuedResourceStatusFailedData",
      "description": "Additional status detail for the FAILED state.",
      "type": "object",
      "properties": {
        "error": {
          "description": "The error(s) that caused the QueuedResource to enter the FAILED state.",
          "type": "object",
          "properties": {
            "errors": {
              "description": "[Output Only] The array of errors encountered while processing this\noperation.",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "description": "[Output Only] The error type identifier for this error.",
                    "type": "string"
                  },
                  "location": {
                    "description": "[Output Only] Indicates the field in the request that caused the error.\nThis property is optional.",
                    "type": "string"
                  },
                  "message": {
                    "description": "[Output Only] An optional, human-readable error message.",
                    "type": "string"
                  },
                  "errorDetails": {
                    "description": "[Output Only] An optional list of messages that contain the error\ndetails. There is a set of defined message types to use for providing\ndetails.The syntax depends on the error code. For example,\nQuotaExceededInfo will have details when the error code is\nQUOTA_EXCEEDED.",
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "errorInfo": {
                          "$ref": "ErrorInfo"
                        },
                        "quotaInfo": {
                          "$ref": "QuotaExceededInfo"
                        },
                        "help": {
                          "$ref": "Help"
                        },
                        "localizedMessage": {
                          "$ref": "LocalizedMessage"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
