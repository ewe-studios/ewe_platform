# Build storage lives on the large volume: one target directory for every
# worktree, and the registry on the same volume.
# See .agents/skills/rust-clean-code/directory-and-configuration/examples/build-storage.md
export CARGO_TARGET_DIR=/Volumes/Outside/cargo-target
export CARGO_HOME=/Volumes/Outside/cargo-home
export PATH="$CARGO_HOME/bin:$PATH"
