# Shell scripts and their templates must keep LF on every operating system.
# They run on Unix hosts, and a CRLF checkout breaks their here-document
# markers and the generated systemd units.
*.sh text eol=lf
*.j2 text eol=lf
*.service text eol=lf

# Generated wire checks compare these files with the generator output.
backends/foundation_wasm_ui/runtimes/foundation-ui-vocab.js text eol=lf
backends/foundation_ui_wire/fixtures/native/*.expected.json text eol=lf
mobile/android/core/src/test/resources/native/*.expected.json text eol=lf
mobile/ios/Tests/EweUITests/Fixtures/*.expected.json text eol=lf
