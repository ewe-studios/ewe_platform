[submodule "tools/emsdk"]
	path = tools/emsdk
	url = https://github.com/emscripten-core/emsdk.git
[submodule "tools/dawn"]
	path = tools/dawn
	depth = 1
	url = https://github.com/google/dawn.git
[submodule "tools/whisper.cpp"]
	path = tools/whisper.cpp
	url = https://github.com/ggml-org/whisper.cpp.git
[submodule ".agents"]
	path = .agents
	url = https://github.com/ewe-studios/agentic-coding-starter.git
[submodule "infrastructure/llama-bindings/llama.cpp"]
	path = infrastructure/llama-bindings/llama.cpp
	url = https://github.com/ggml-org/llama.cpp
[submodule "artefacts/models/whisper.cpp"]
	path = artefacts/models/whisper.cpp
	url = https://huggingface.co/ggerganov/whisper.cpp
[submodule "foundations/tauri"]
	path = foundations/tauri
	url = git@github.com:rstkit/tauri.git
[submodule "foundations/tao"]
	path = foundations/tao
	url = git@github.com:rstkit/tao.git
[submodule "foundations/tauri-bindgen"]
	path = foundations/tauri-bindgen
	url = git@github.com:rstkit/tauri-bindgen.git
[submodule "foundations/wry"]
	path = foundations/wry
	url = git@github.com:rstkit/wry.git
[submodule "foundations/tauri-docs"]
	path = foundations/tauri-docs
	url = git@github.com:tauri-apps/tauri-docs.git
