[package]
name = "http-app"
version = "0.0.1"
edition = "2021"
rust-version = "1.75"
license = "Apache-2.0"
authors = ["EweStudios Consulting Limited"]
repository = "{{GITHUB_NAMESPACE}}/{{PROJECT_NAME}}"
keywords = ["http-app"]

[lib]
path = "./src/lib.rs"
test = true
doctest = true
bench = false
doc = true
crate-type = ['lib']
required-features = []

[[bin]]
name = "dev"
test = false
bench = false

[[bin]]
name = "app"
test = false
bench = false

[dependencies]

# -- ewe platform dependencies
foundation_toolings = { version = "0.0.6" }
foundation_http = { version = "0.0.8", features = ["multi"] }
foundation_core = { version = "0.0.16", features = ["multi"] }
foundation_config = { version = "0.1.2" }

# directory embedding
rust-embed = "8.5.0"

# -- serialization crates
serde = { version = "1.0.197", features = ["derive"] }

# -- tracing crates
tracing = { version = "0.1.40" }
tracing-subscriber = { version = "0.3.18" }
