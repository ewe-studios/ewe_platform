[package]
name = "static-html-app"
version = "0.0.1"
edition = "2021"
rust-version = "1.98"
license = "Apache-2.0"
authors = ["EweStudios Consulting Limited"]
repository = "{{GITHUB_NAMESPACE}}/{{PROJECT_NAME}}"
keywords = ["static-html-app", "static html app"]

[dependencies]

# -- ewe platform dependencies
foundation_http = { version = "0.0.16", features = ["multi"] }
foundation_core = { version = "0.0.23", features = ["multi"] }

# directory embedding
foundation_resources = { version = "0.1.1", default-features = false, features = ["server"] }
foundation_macros = "0.0.25"
foundation_nostd = "0.0.10"

# -- tracing crates
tracing = { version = "0.1.40" }
tracing-subscriber = { version = "0.3.18" }

[features]
default = []

[build-dependencies]
foundation_resources = { version = "0.1.1", default-features = false, features = ["build"] }
