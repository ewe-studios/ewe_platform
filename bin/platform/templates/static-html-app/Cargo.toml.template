[package]
name = "static-html-app"
version = "0.0.1"
edition = "2021"
rust-version = "1.75"
license = "Apache-2.0"
authors = ["EweStudios Consulting Limited"]
repository = "{{GITHUB_NAMESPACE}}/{{PROJECT_NAME}}"
keywords = ["static-html-app", "static html app"]

[dependencies]

# -- ewe platform dependencies
foundation_http = { version = "0.0.10", features = ["multi"] }
foundation_core = { version = "0.0.19", features = ["multi"] }

# directory embedding
rust-embed = "8.5.0"

# -- tracing crates
tracing = { version = "0.1.40" }
tracing-subscriber = { version = "0.3.18" }

[features]
default = []
